# Hosta - Web Hosting Configuration & HestiaCP Connector

PORT=3001

# Neon PostgreSQL Database Connection
DATABASE_URL=postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/hosta?sslmode=require

# HestiaCP Server Configuration
HESTIA_HOST=https://your-server-ip:8083
HESTIA_PORT=8083

# Authentication: 'access_key' (recommended in HestiaCP v1.4+) or 'user_pass'
HESTIA_AUTH_TYPE=access_key

# If using API Access Key:
HESTIA_ACCESS_KEY=
HESTIA_SECRET_KEY=

# If using Username / Password:
HESTIA_USERNAME=admin
HESTIA_PASSWORD=

# Default settings
HESTIA_DEFAULT_USER=admin
HESTIA_DEFAULT_PACKAGE=default
HESTIA_ALLOW_SELF_SIGNED=true

# Optional SMTP Email Configuration (for sending real 6-digit confirmation codes)
# Leave blank to run in simulation/console dev mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hosta Philippines" <noreply@hosta.site>

